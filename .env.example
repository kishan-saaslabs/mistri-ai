# Copy this file to `.env` and fill in values locally.
# Never commit `.env` or real credentials.

# --- Postgres (docker compose + API) ---
POSTGRES_USER=mistri
POSTGRES_PASSWORD=
POSTGRES_DB=mistri
POSTGRES_PORT=5432
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/mistri

# --- Redis (docker compose + API job queue) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API ---
NODE_ENV=development
API_PORT=3001
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Public origin of this API, used in call `fileUrl` values (no trailing slash).
# Leave empty to use the incoming request host.
API_PUBLIC_URL=http://localhost:3001
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=52428800

# PyAI Hear (speech-to-text). Never commit a real key.
PYAI_API_KEY=
PYAI_BASE_URL=https://api.pyai.com
PYAI_TRANSCRIBE_MODEL=pyai-hear-telephony
# How long one API process polls a Hear job (ms). Job id is saved; restart resumes.
# PYAI_POLL_TIMEOUT_MS=1800000
# PYAI_POLL_INTERVAL_MS=2000

# --- LLM (speaker name inference, apps/ai) ---
# Any OpenAI-compatible chat completions endpoint works here — NVIDIA NIM (free tier,
# BYOK: build.nvidia.com -> API Catalog -> generate key), OpenAI, Groq, Together.ai, etc.
# Switching providers is config-only: change these four vars, no code changes.
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=meta/llama-3.1-8b-instruct

# BullMQ queue names (apps/api/src/queue). Change only if this Redis is
# shared with another app/queue of the same name.
QUEUE_INFER_AND_RENAME_NAME=infer-and-rename
QUEUE_CALL_INSIGHTS_NAME=call-insights

# Used only by `pnpm db:seed` for the demo user (min 10 chars). Leave empty in committed files.
SEED_USER_PASSWORD=

# --- Frontend ---
VITE_API_URL=http://localhost:3001

# Copy this file to `.env` and fill in values locally.
# Never commit `.env` or real credentials.

# --- Postgres (docker compose + API) ---
POSTGRES_USER=mistri
POSTGRES_PASSWORD=
POSTGRES_DB=mistri
POSTGRES_PORT=5432
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/mistri

# --- Redis (docker compose + API job queue) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API ---
NODE_ENV=development
API_PORT=3001
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Public origin of this API, used in call `fileUrl` values (no trailing slash).
# Leave empty to use the incoming request host.
API_PUBLIC_URL=http://localhost:3001
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=536870912

# --- Object storage (MinIO locally; S3-compatible in production) ---
# Browser uploads go to a private bucket via presigned PUT. PyAI Hear fetches
# a presigned GET at S3_PUBLIC_ENDPOINT (must be public https for large files).
S3_ENDPOINT=http://localhost:9000
S3_BROWSER_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=
# Optional public https origin of this API if PyAI must fetch recordings via
# GET /api/calls/:id/provider-audio. Leave empty for local MinIO + multipart
# (files over ~24MB need a public S3_PUBLIC_ENDPOINT instead).
PYAI_FETCH_BASE_URL=
S3_REGION=us-east-1
S3_BUCKET=mistri-calls
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001
# S3_PRESIGN_PUT_EXPIRES_SECONDS=900
# S3_PRESIGN_GET_EXPIRES_SECONDS=7200

# PyAI Hear (speech-to-text). Never commit a real key.
PYAI_API_KEY=
PYAI_BASE_URL=https://api.pyai.com
PYAI_TRANSCRIBE_MODEL=pyai-hear-telephony
# How long one API process polls a Hear job (ms). Job id is saved; restart resumes.
# PYAI_POLL_TIMEOUT_MS=1800000
# PYAI_POLL_INTERVAL_MS=2000

# --- LLM: speaker naming (apps/ai) ---
# Any OpenAI-compatible chat completions endpoint works here — NVIDIA NIM (free tier,
# BYOK: build.nvidia.com -> API Catalog -> generate key), OpenAI, Groq, Together.ai, etc.
# Switching providers is config-only: change these vars, no code changes.
# Cheap task, has a safe positional fallback if the model gets it wrong — a
# small/fast model is the right tradeoff here.
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=meta/llama-3.1-8b-instruct

# --- LLM: call insights (apps/ai) — fully independent profile ---
# No safe fallback if this fails, and it asks for more structured output (5
# sub-schemas, exact quote reproduction) in one response — worth a larger/
# different model. Every var below is independently optional and falls back
# to its speaker-naming counterpart above if unset, so this can point at a
# wholly different provider/account, not just a different model on the same
# one. Leave all unset to just reuse the speaker-naming connection as-is.
LLM_PROVIDER_INSIGHTS=
LLM_BASE_URL_INSIGHTS=
LLM_API_KEY_INSIGHTS=
LLM_MODEL_INSIGHTS=nvidia/llama-3.3-nemotron-super-49b-v1.5
# Optional reasoning-mode toggle for reasoning models. Leave unset to use the
# model's own default (nothing is sent). true/false only — sent as
# chat_template_kwargs.enable_thinking (vLLM/Qwen3-style convention); unverified
# against any specific model's docs, so confirm live before relying on it.
LLM_THINKING_MODE_INSIGHTS=

# --- LLM: chunk/topic embedding (apps/ai) — independent profile ---
# Embedding is a wholly different wire format (POST /embeddings, not
# /chat/completions) and is frequently a different account even when the
# provider is the same one used for chat. Falls back to the base
# LLM_PROVIDER/LLM_BASE_URL/LLM_API_KEY/LLM_MODEL above if unset — but in
# practice you almost always want LLM_MODEL_EMBEDDING set explicitly, since
# the base LLM_MODEL is a chat-completions model, not an embeddings one.
LLM_PROVIDER_EMBEDDING=
LLM_BASE_URL_EMBEDDING=
LLM_API_KEY_EMBEDDING=
LLM_MODEL_EMBEDDING=
# Fixed per deployment — pgvector's chunk_embeddings.embedding column is
# vector(1024). Changing this after chunks already exist requires a
# re-embedding migration, not just an env change.
LLM_EMBEDDING_DIMENSIONS=1024

# --- LLM: chat (apps/ai) — independent profile ---
# Interactive call site (one call per chat turn, streamed) — a distinct
# latency/volume profile from insights, so it gets its own connection.
LLM_PROVIDER_CHAT=
LLM_BASE_URL_CHAT=
LLM_API_KEY_CHAT=
LLM_MODEL_CHAT=
LLM_THINKING_MODE_CHAT=

# BullMQ queue names (apps/api/src/queue). Change only if this Redis is
# shared with another app/queue of the same name.
QUEUE_INFER_AND_RENAME_NAME=infer-and-rename
QUEUE_CALL_INSIGHTS_NAME=call-insights
QUEUE_KB_INGEST_NAME=kb-ingest

# Used only by `pnpm db:seed` for the demo user (min 10 chars). Leave empty in committed files.
SEED_USER_PASSWORD=

# --- Frontend ---
VITE_API_URL=http://localhost:3001

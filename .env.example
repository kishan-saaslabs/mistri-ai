# Copy this file to `.env` and fill in values locally.
# Never commit `.env` or real credentials.

# --- Postgres (docker compose + API) ---
POSTGRES_USER=mistri
POSTGRES_PASSWORD=
POSTGRES_DB=mistri
POSTGRES_PORT=5432
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/mistri

# --- API ---
NODE_ENV=development
API_PORT=3001
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=52428800

# --- Frontend ---
VITE_API_URL=http://localhost:3001
